# Production muhiti (T-092). Nusxa oling: cp .env.prod.example .env.prod — .env.prod repoga tushmaydi.
# Ishga tushirish: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Domenlar (DNS A yozuvlari server IP siga yo'naltirilgan bo'lsin)
API_DOMAIN=api.example.uz
ADMIN_DOMAIN=admin.example.uz
# Let's Encrypt xabarlari uchun
ACME_EMAIL=admin@example.uz

# Sirlar: `openssl rand -base64 48` bilan yarating
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

# Ixtiyoriy
POSTGRES_DB=pos
POSTGRES_USER=pos
GUNICORN_WORKERS=3
DJANGO_HSTS_SECONDS=31536000
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
APP_VERSION=
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

# Lokal sinov uchun (serverda bo'sh qoldiring):
# CADDY_TLS=tls internal
# HTTP_PORT=8080
# HTTPS_PORT=8443
