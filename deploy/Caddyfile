# Caddy (T-092): avtomatik HTTPS (Let's Encrypt). Ikki domen:
#   API_DOMAIN   — Django API (kassa ilovasi va admin shu yerga ulanadi), /static, /admin
#   ADMIN_DOMAIN — admin dashboard (Next.js)
# Lokal sinov: CADDY_TLS=internal (o'z-o'zidan imzolangan sertifikat).
{
	email {$ACME_EMAIL}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	{$CADDY_TLS:}
}

{$API_DOMAIN} {
	import common
	handle_path /static/* {
		root * /srv/static
		file_server
	}
	handle {
		reverse_proxy backend:8000
	}
}

{$ADMIN_DOMAIN} {
	import common
	reverse_proxy admin:3000
}
